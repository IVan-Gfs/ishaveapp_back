generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model agendamento {
  idAgendamento      Int               @id @default(autoincrement())
  horarioAgendamento DateTime?         @db.DateTime(0)
  idCliente          Int               @unique
  idSvcPtd           Int               @unique
  empresaId          Int               @unique
  createdAt          DateTime          @default(now())
  servicoPrestador   servico_prestador @relation(fields: [idSvcPtd], references: [idSvcPtd])
  empresa           empresa          @relation(fields: [empresaId], references: [idEmpresa])

  @@index([idCliente])
  @@index([idSvcPtd])
  @@index([empresaId])
}

model cliente {
  idCliente       Int     @id @default(autoincrement())
  nomeCliente     String  @db.VarChar(150)
  telCliente      String? @db.VarChar(11)
  cpfCliente      String? @db.VarChar(15)
  emailCliente    String? @db.VarChar(255)
  dataNascCliente String  @db.VarChar(10)
}

model prestador {
  idPrestador       Int                 @id @default(autoincrement())
  nomePrestador     String              @db.VarChar(150)
  telPrestador      String              @db.VarChar(20)
  cpfPrestador      String              @db.VarChar(15)
  emailPrestador    String              @db.VarChar(255)
  dataNascPrestador String?             @db.VarChar(10)
  servicos          servico_prestador[]
  usuario           usuarios[]
}

model servico {
  idServico        Int                 @id @default(autoincrement())
  nomeServico      String              @db.VarChar(50)
  precoServico     Decimal             @db.Decimal(6, 2)
  descricaoServico String?             @db.VarChar(200)
  categoriaServico String              @db.VarChar(100)
  prestadores      servico_prestador[]
}

model empresa {
  idEmpresa   Int        @id @default(autoincrement())
  cnpjEmpresa String     @db.VarChar(25)
  nomeEmpresa String     @db.VarChar(255)
  telEmpresa  String     @db.VarChar(20)
  enderecoId  Int        @unique  
  endereco    endereco   @relation(fields: [enderecoId], references: [idEndereco])
  usuario     usuarios[]
  agendamento agendamento[]
  @@index([enderecoId])
  
}

model endereco {
  idEndereco  Int           @id @default(autoincrement())
  bairro      String?       @db.VarChar(255)
  cep         String        @db.VarChar(9)
  cidade      String?       @db.VarChar(150)
  nomeRua     String        @db.VarChar(150)
  numero      String        @db.VarChar(10)
  empresa     empresa[]
}

model servico_prestador {
  idSvcPtd    Int           @id @default(autoincrement())
  servicoId   Int
  prestadorId Int
  prestador   prestador     @relation(fields: [prestadorId], references: [idPrestador])
  servico     servico       @relation(fields: [servicoId], references: [idServico])
  agendamento agendamento[]

  @@index([servicoId])
  @@index([prestadorId])
}

model usuarios {
  idUsuario    Int        @id @default(autoincrement())
  nomeUsuario  String     @unique @db.VarChar(30)
  emailUsuario String     @unique @db.VarChar(255)
  senhaUsuario String     @db.VarChar(255)
  prestadorId  Int?
  empresaId    Int
  prestador    prestador? @relation(fields: [prestadorId], references: [idPrestador])
  empresa      empresa    @relation(fields: [empresaId], references: [idEmpresa])
  session      session[]

  @@index([prestadorId])
  @@index([empresaId])
}

model session {
  idSession Int      @id @default(autoincrement())
  idUsuario Int
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
  usuario   usuarios @relation(fields: [idUsuario], references: [idUsuario])

  @@index([idUsuario])
}

model urlConfirm {
  id         Int      @id @default(autoincrement())
  url        String   @db.Text
  expires_at DateTime
}

model codAuth {
  idCodAuth  Int      @id @default(autoincrement())
  codigo     String   @db.VarChar(6)
  email      String   @db.VarChar(255)
  expired_at DateTime
}
