generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model agendamento {
  idAgendamento      Int       @id @default(autoincrement())
  servicoAgendamento String    @db.VarChar(50)
  horarioAgendamento DateTime? @db.DateTime(0)
}

model cliente {
  idCliente    Int     @id @default(autoincrement())
  nomeCliente  String  @db.VarChar(150)
  telCliente   String? @db.VarChar(11)
  cpfCliente   String? @db.VarChar(15)
  emailCliente String? @db.VarChar(255)
}

model optService {
  idOptService     Int      @id @default(autoincrement())
  nameService      String   @db.VarChar(100)
  precoService     Decimal? @db.Decimal(5, 2)
  descricaoService String?  @db.VarChar(255)
}

model prestador {
  idPrestador    Int    @id @default(autoincrement())
  nomePrestador  String @db.VarChar(150)
  telPrestador   String @db.VarChar(11)
  cpfPrestador   String @db.VarChar(15)
  emailPrestador String @db.VarChar(150)
}
